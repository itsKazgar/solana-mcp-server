# RPC endpoint - use Helius for best performance (https://helius.dev)
# Free tier available - just sign up and get your API key
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
# Or use the free public endpoint (less reliable):
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

WALLET_PRIVATE_KEY=your_private_key_here
MCP_AUTH_TOKEN=your_strong_random_token_here
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000
PAPER_MODE=true
